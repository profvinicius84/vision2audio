<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Vision2Audio.App.Controls"
             x:Class="Vision2Audio.App.MainPage"
             Title="">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Border Padding="16" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="8">
                    <Picker Title="Selecionar câmera"
                            ItemsSource="{Binding CameraChoices}"
                            ItemDisplayBinding="{Binding DisplayName}"
                            SelectedItem="{Binding SelectedCameraChoice, Mode=TwoWay}" />

                    <Grid HeightRequest="220">
                        <controls:CameraPreviewView SelectionKind="{Binding SelectedCameraKind}"
                                                    RefreshToken="{Binding PreviewRefreshToken}"
                                                    IsPaused="{Binding IsPreviewPaused}" />
                        <Image Source="{Binding CapturedImageSource}"
                               IsVisible="{Binding IsCapturedImageVisible}"
                               Aspect="AspectFill"
                               BackgroundColor="Black" />
                    </Grid>

                    <Label Text="Fallback ativo: usando outra câmera disponível."
                           IsVisible="{Binding IsFallbackActive}"
                           FontSize="12"
                           Opacity="0.8" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="8">
                <Label Text="Status" FontAttributes="Bold" />
                <Label Text="{Binding StatusMessage}" LineBreakMode="WordWrap" />
                <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsRequestingDescription}">
                    <ActivityIndicator IsRunning="{Binding IsRequestingDescription}"
                                       IsVisible="{Binding IsRequestingDescription}" />
                    <Label Text="Analisando com IA..." VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="Última descrição" FontAttributes="Bold" Margin="0,8,0,0" />
                <Label Text="{Binding LatestDescription}" LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="12">
                <Button Text="Capturar agora"
                        Command="{Binding CaptureCommand}" />
                <Button Text="Limpar histórico"
                        Command="{Binding ClearHistoryCommand}" />
            </HorizontalStackLayout>

            <CollectionView ItemsSource="{Binding History}"
                            SelectionMode="None"
                            HeightRequest="360">
                <CollectionView.Header>
                    <Label Text="Histórico local" FontAttributes="Bold" />
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,8" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding CapturedAtUtc, StringFormat='{}{0:dd/MM/yyyy HH:mm} UTC'}" FontAttributes="Bold" />
                                <Label Text="{Binding Description}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Use o botão de volume, Bluetooth ou teclado para capturar."
                   FontSize="12"
                   Opacity="0.8" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
